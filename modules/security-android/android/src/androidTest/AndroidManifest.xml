<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    T3.2: the library androidTest APK is self-targeted, so the production app context is resolved
    explicitly with createPackageContext(<applicationId>). Android 11+ package visibility hides the
    app from the test APK without this <queries> declaration (NameNotFoundException otherwise).
  -->
  <queries>
    <package android:name="io.github.realalexkwok.nexvault" />
  </queries>
  <application>
    <activity
      android:name="expo.modules.securityandroid.TestBiometricActivity"
      android:exported="false"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
  </application>
</manifest>
