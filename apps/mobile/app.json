{
  "expo": {
    "name": "NexVault",
    "slug": "nexvault",
    "scheme": "nexvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.realalexkwok.nexvault",
      "deploymentTarget": "18.0"
    },
    "android": {
      "package": "io.github.realalexkwok.nexvault",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/withVaultCoreTests",
      "./plugins/withSecurityHashes",
      "expo-router",
      "expo-status-bar",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "inter-regular",
                "fontDefinitions": [{ "path": "./assets/fonts/inter_regular.ttf", "weight": 400 }]
              },
              {
                "fontFamily": "inter-medium",
                "fontDefinitions": [{ "path": "./assets/fonts/inter_medium.ttf", "weight": 500 }]
              },
              {
                "fontFamily": "inter-semibold",
                "fontDefinitions": [{ "path": "./assets/fonts/inter_semibold.ttf", "weight": 600 }]
              },
              {
                "fontFamily": "inter-bold",
                "fontDefinitions": [{ "path": "./assets/fonts/inter_bold.ttf", "weight": 700 }]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/inter_regular.ttf",
              "./assets/fonts/inter_medium.ttf",
              "./assets/fonts/inter_semibold.ttf",
              "./assets/fonts/inter_bold.ttf"
            ]
          }
        }
      ],
      "expo-secure-store"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
