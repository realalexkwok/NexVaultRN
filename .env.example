# Key names only — never commit values.
# Sensitive config goes in .env (gitignored); injected via expo-constants extra.
# Missing config must render "Not configured" in the UI (R5), never fake data.

# EVM RPC / chain data provider
INFURA_API_KEY=

# Public RPC endpoint override (leave empty to derive from INFURA_API_KEY)
EXPO_PUBLIC_RPC_URL=

# EAS (only for local automation; production environments use GitHub environment secrets)
EXPO_TOKEN=
